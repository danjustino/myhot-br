# Configuração do MyHOT. Copie para .env e ajuste (ou rode node scripts/init-env.ts, que gera o .env com chaves aleatórias).
# O front-end só recebe o endereço do site; todas as chaves ficam no backend. Não faça commit do .env no Git.

# ===== Obrigatório =====

# Endereço público do site: links gerados, RSS, imagens de compartilhamento e MCP usam este valor. Para testar na máquina, use o de baixo.
SITE_URL=http://localhost:3000

# Senha do admin (pelo menos 12 caracteres), para entrar em /admin.
ADMIN_PASSWORD=

# Chaves de assinatura da sessão e do proxy de imagens; uma sequência aleatória em cada (dá para gerar com openssl rand -hex 32).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Senha do banco quando se usa Docker (o banco não abre porta para fora, mas use caracteres aleatórios mesmo assim).
POSTGRES_PASSWORD=

# Modelo: qualquer API compatível com a da OpenAI serve, e todas as etapas usam este por padrão. Abaixo, o exemplo do DeepSeek.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Parâmetros de requisição próprios do provedor (JSON), por exemplo para desligar o modo de raciocínio:
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# Exemplos de outros provedores:
#   Qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   Zhipu     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# Ligue se o modelo enxerga imagens (o título e o resumo dos destaques passam a considerar a primeira imagem):
# LLM_VISION=true
# Desligue se o serviço não aceitar o modo JSON (response_format):
# LLM_JSON_MODE=false
# Cota de saída extra reservada ao raciocínio em modelos de raciocínio (pensam antes de responder; raciocínio e resposta dividem a cota de saída), somada à cota de cada etapa; vazio é 0.
# Defina quando a chamada der "output token limit reached (finish_reason=length)", por exemplo:
# LLM_REASONING_TOKENS=4000

# ===== Opcional: agrupamento de fatos mais preciso =====

# Busca por vetores: qualquer endpoint /embeddings compatível com a OpenAI. Funciona sem: o agrupamento passa a buscar candidatos pela sobreposição de texto,
# mas os posts de discussão que só servem de evidência de popularidade (fontes hot_signal) quase não se ligam aos fatos, e a popularidade fica baixa.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Ou preencha só a chave do Alibaba Cloud Bailian para usar o text-embedding-v4:
# DASHSCOPE_API_KEY=
# Dimensão dos vetores (com EMBEDDING_* vem do serviço por padrão; no Bailian, 1024); mudar recalcula os vetores antigos:
# EMBEDDING_DIMS=

# ===== Opcional: trocar o modelo de cada etapa =====
# Por padrão todas as etapas usam o LLM_* acima. Para uma etapa usar outro provedor, informe o nome da predefinição (com a chave correspondente):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Nomes das predefinições e chaves necessárias:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Atenção: com DASHSCOPE_API_KEY preenchida e EMBEDDING_API_KEY vazia, o agrupamento usa sozinho os vetores do Bailian (text-embedding-v4), cobrados à parte pelo preço do Bailian.

# ===== Opcional: serviços de coleta pagos (cobrados por requisição, com disjuntor de orçamento ajustável em "Configurações" no painel) =====
# Contas do X (Twitter): SocialData
# SOCIALDATA_API_KEY=
# Contas oficiais do WeChat: Dajiala
# DAJIALA_KEY=
# Renderização em navegador quando o corpo não vem: Jina Reader
# JINA_API_KEY=

# ===== Opcional: Feishu =====
# Envio da seleção para um grupo do Feishu (só a seleção das fontes T1 e T1_5): ative em "Configurações → Destinos de notificação" no painel e coloque aqui o endereço do webhook.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alertas e feedback repassados para um grupo interno do Feishu (o feedback precisa de um aplicativo próprio do Feishu):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Alertas só em texto também podem ir para o robô personalizado de um grupo: preenchido, os alertas vão pelo webhook, sem usar o aplicativo e o ID do grupo acima (sem gastar chamadas de API do aplicativo).
# FEISHU_ALERT_WEBHOOK_URL=
# Alertas passam antes pelo seu serviço de tratamento automático (por exemplo um repassador de webhook que acorda uma IA); só vale com os dois preenchidos e FEISHU_INTERNAL_ENABLED=true:
# Os alertas a tratar vão por POST para este endereço (Authorization: Bearer <KEY>, campos JSON id, type, subject, summary, detail, link); resposta 200 conta como aceito, e o mesmo id pode ser reenviado;
# alertas, recuperações e o relatório do sistema para você vão antes por POST para /tell na raiz do mesmo host (campos JSON key, text) e, se não forem aceitos, seguem pelo Feishu acima. Comportamento em "Atualizar" no docs/deploy.md.
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=

# ===== Opcional: DingTalk =====
# Envio da seleção para um grupo do DingTalk (mesmo fluxo do envio para o Feishu, também só a seleção das fontes T1 e T1_5):
# ative "Grupo de conteúdo do DingTalk" em "Configurações → Destinos de notificação" no painel e coloque aqui o endereço do webhook.
# DINGTALK_CONTENT_PUSH_ENABLED=true
# Endereço do webhook do robô personalizado do DingTalk (com access_token):
# DINGTALK_PUSH_WEBHOOK_URL=
# Só preencha se a segurança do robô usa "assinatura" (a sequência que começa com SEC); com "palavras-chave" ou "lista de IPs", deixe vazio:
# DINGTALK_PUSH_SECRET=

# ===== Opcional: outros =====
# Fontes JSON que leem a API do GitHub (api.github.com) usam isto para ter mais cota. O GitHub dá de graça; basta permissão de leitura:
# GITHUB_TOKEN=
# Token para scripts externos enviarem conteúdo ao site (POST /api/ingest/items), com pelo menos 16 caracteres; vazio desliga essa interface.
# INGEST_TOKEN=
# Máximo de envios por minuto por cliente na interface de envio (docker compose usa 10 por padrão); se o proxy reverso à frente já limita, pode ser 0:
# INGEST_RATE_LIMIT=10
# Quando a coleta de fontes do exterior precisa de proxy (por exemplo, servidor na China continental):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# Servidores DoH usados para resolver os domínios que passam pelo proxy, tentados em ordem, separados por vírgula (o padrão são estes dois).
# Em alguns ambientes com proxy, cloudflare-dns.com não conecta (o handshake TLS é cortado); aí o segundo serve de reserva:
# EGRESS_DNS_UPSTREAMS=https://cloudflare-dns.com/dns-query, https://dns.google/resolve
# Por padrão o domínio é resolvido e conferido como endereço público antes, e só então o proxy conecta nesse endereço (contra DNS rebinding). Alguns proxies com regras de roteamento não aceitam túnel por IP
# (a conexão é reiniciada); nesse caso use false: a conferência é feita uma vez, mas o proxy resolve de novo ao conectar, e se a segunda resolução apontar para a rede interna não há como barrar.
# Só use assim quando o próprio proxy não alcança a rede interna nem serviços da máquina:
# EGRESS_PIN_DNS=false
# Quando o endereço de feed ou de lista é um serviço próprio na rede interna (por exemplo um RSSHub na mesma rede Docker), escreva os hosts completos separados por vírgula (sem diferenciar maiúsculas, sem curingas).
# Só esses endereços são liberados, com acesso direto, sem o proxy acima; redirecionamentos para outros hosts, corpo dos artigos e imagens continuam sem acesso à rede interna, e endereços link-local e de metadados de nuvem são sempre recusados:
# PRIVATE_FEED_HOSTS=rsshub
# Limite de tráfego do proxy de imagens ao buscar no site original (MB por minuto, GB por dia); passou, imagens sem cache devolvem 503; vazio usa DEPLOYMENT.imageUpstreamBudget do site/site.ts, que por padrão não tem limite:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# Defina true quando houver um proxy reverso como Caddy ou Nginx à frente, para o endereço do visitante vir do X-Forwarded-For do proxy;
# com o site exposto direto, mantenha false, para ninguém forjar endereço e burlar os limites de tentativas de login e de feedback.
TRUST_PROXY=false
# O MCP só aceita requisições para o domínio do SITE_URL (e localhost); se houver outros domínios de acesso, escreva aqui separados por vírgula:
# MCP_ALLOWED_HOSTS=
# Quanto tempo sem conteúdo novo conta como "coleta parada" e gera alerta (minutos); vazio usa ALERTS.quietMinutes do site/site.ts (padrão 360):
# ALERT_QUIET_MINUTES=360
# Envio diário das páginas novas para o IndexNow (Bing e outros); a chave tem 32 caracteres hexadecimais, gere uma você mesmo:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Envio de hora em hora das páginas novas para o Baidu; verifique antes o site na plataforma de busca do Baidu; o token é o trecho final do endereço de envio em "普通收录 · API提交":
BAIDU_PUSH_ENABLED=false
# BAIDU_PUSH_TOKEN=
# Backup diário do banco para um armazenamento de objetos compatível com S3 (Tencent Cloud COS, AWS S3, Alibaba Cloud OSS…).
# Sem DB_BACKUP_STORE_DOMAIN, o endereço é montado no padrão do Tencent Cloud COS (<bucket>.cos.<região>.myqcloud.com);
# para outro provedor, informe o domínio de acesso com o nome do bucket, por exemplo no AWS S3 my-bucket.s3.us-east-1.amazonaws.com:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Nível de log (padrão info) e limite do pool de conexões do banco (padrão 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Nome da versão: aparece na página "Execuções" do painel e em /api/health, para confirmar que os processos foram trocados depois de atualizar:
# AIHOT_RELEASE=
# Nome do ambiente; por padrão vem do NODE_ENV como production ou development; fora de production os alertas trazem esse nome, e o login dispensado de desenvolvimento só funciona fora de production:
# AIHOT_ENVIRONMENT=
# Guarde as chaves por grupo numa pasta (models.env, collectors.env, integrations.env, auth.env) em vez de escrever aqui; o que estiver aqui tem prioridade:
# AIHOT_CREDENTIALS_DIR=

# ===== Travas de segurança =====
# Só com true há coleta das fontes (inclusive a busca diária dos ícones) e chamadas de modelo; apague estas duas linhas ou use false para parar tudo (útil ao mexer na interface).
# Todas as chaves *_ENABLED deste arquivo só aceitam true; 1, yes ou TRUE contam como desligado.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Só necessário sem Docker, rodando direto na máquina =====
# DATABASE_URL=postgres://usuario@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# Pasta para arquivos enviados, cache de imagens e backup local (padrão: .data no repositório):
# AIHOT_DATA_DIR=/var/lib/myhot
# Entrar no painel sem login durante o desenvolvimento (a produção se recusa a subir assim), e o nome mostrado no painel:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Permitir coleta de endereços internos para depuração local (proibido por padrão; a produção se recusa a subir assim):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== Com docker compose --profile https =====
# SITE_DOMAIN=example.com
# Porta do site na máquina (usada pelo docker compose; padrão 3000, acessível por todas as interfaces de rede); com HTTPS, fica só para o Caddy local, sem acesso externo direto:
# PORT=127.0.0.1:3000
# E mude o TRUST_PROXY acima para true.
